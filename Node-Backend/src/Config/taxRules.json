      "title": "Purchase of Goods Exceeding ₹50 Lakhs",
      "annualThreshold": 5000000,
      "buyerTurnoverThreshold": 100000000,
      "rate": 0.001,
      "rateWithoutPan": 0.05,
      "disallowanceSection": "40(a)(ia)",
      "disallowancePercentage": 0.30,
