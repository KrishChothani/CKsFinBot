  "disallowanceRules": {
    "section40A3": {
      "section": "Section 40A(3)",
      "title": "Cash Payment Disallowance Exceeding ₹10,000",
      "dailyCashLimit": 10000,
      "goodsCarriageCashLimit": 35000,
      "disallowancePercentage": 1.0,
      "description": "Any expenditure paid in cash to a person in a single day exceeding ₹10,000 is 100% disallowed from taxable business income under Section 40A(3)."
    },
    "section43Bh": {
      "section": "Section 43B(h)",
      "title": "MSME Timely Payment Deduction Rule (45-Day Rule)",
      "statutoryDaysWithoutAgreement": 15,
      "statutoryDaysWithAgreement": 45,
      "disallowancePercentage": 1.0,
      "description": "Any sum payable to a Micro or Small Enterprise beyond 45 days (or 15 days without written agreement) is disallowed under Section 43B(h) and added back to taxable income if unpaid at year-end."
    }
  }
