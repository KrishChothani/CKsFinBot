{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CKsFinBot Golden Dataset Ground-Truth Label Schema",
  "type": "object",
  "required": [
    "caseId",
    "documentType",
    "fileName",
    "groundTruth"
  ],
  "properties": {
    "caseId": { "type": "string" },
    "documentType": {
      "type": "string",
      "enum": ["Purchase_Invoice", "Sales_Invoice", "Expense_Bill", "Bank_Statement", "GSTR_2B"]
    },
    "fileName": { "type": "string" },
    "description": { "type": "string" },
    "isAnonymized": { "type": "boolean", "default": true },
    "groundTruth": {
      "type": "object",
      "required": [
        "invoiceNumber",
        "invoiceDate",
        "supplierGstin",
        "taxableAmountPaise",
        "totalTaxPaise",
        "grandTotalPaise"
      ],
      "properties": {
        "invoiceNumber": { "type": "string" },
        "invoiceDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "dueDate": { "type": ["string", "null"] },
        "supplierName": { "type": "string" },
        "supplierGstin": { "type": "string", "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$" },
        "supplierStateCode": { "type": "string" },
        "recipientName": { "type": "string" },
        "recipientGstin": { "type": "string" },
        "recipientStateCode": { "type": "string" },
        "placeOfSupply": { "type": "string" },
        "isInterState": { "type": "boolean" },
        "isMsmeVendor": { "type": "boolean" },
        "msmeCategory": { "type": ["string", "null"], "enum": ["Micro", "Small", "Medium", null] },
        "taxableAmountPaise": { "type": "integer", "minimum": 0 },
        "cgstPaise": { "type": "integer", "minimum": 0 },
        "sgstPaise": { "type": "integer", "minimum": 0 },
        "igstPaise": { "type": "integer", "minimum": 0 },
        "cessPaise": { "type": "integer", "minimum": 0 },
        "totalTaxPaise": { "type": "integer", "minimum": 0 },
        "roundOffPaise": { "type": "integer" },
        "grandTotalPaise": { "type": "integer", "minimum": 0 },
        "lineItems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description", "taxableAmountPaise", "gstRateBasisPoints", "totalAmountPaise"],
            "properties": {
              "description": { "type": "string" },
              "hsnCode": { "type": "string" },
              "quantity": { "type": "number" },
              "unit": { "type": "string" },
              "ratePaise": { "type": "integer" },
              "taxableAmountPaise": { "type": "integer" },
              "gstRateBasisPoints": { "type": "integer" },
              "totalAmountPaise": { "type": "integer" },
              "page": { "type": "integer", "default": 1 },
              "boundingBox": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        }
      }
    }
  }
}

